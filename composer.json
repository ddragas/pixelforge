{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/vue-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "*",
        "tightenco/ziggy": "^2.4"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phparkitect/phparkitect": "^1.3",
        "phpmd/phpmd": "^3.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "lint": [
            "pint --test",
            "rector process --dry-run --no-progress-bar"
        ],
        "fix": [
            "rector process --no-progress-bar",
            "pint"
        ],
        "analyse": [
            "phpstan analyse --memory-limit=1G --no-progress",
            "phpmd analyze app --format text --ruleset phpmd.xml",
            "deptrac analyse --no-progress",
            "phparkitect check"
        ],
        "test": "pest --exclude-testsuite=Browser",
        "test:browser": "pest --testsuite=Browser",
        "test:mutation": "pest --mutate --everything --covered-only --parallel --exclude-testsuite=Browser --exclude-group=timing --path=app --ignore=app/Http/Controllers/Auth,app/Http/Controllers/Settings,app/Http/Requests/Auth,app/Http/Requests/Settings --min=80",
        "test:load": "@php tests/Load/webhook-storm.php",
        "check": [
            "@lint",
            "@analyse",
            "@composer audit --abandoned=report",
            "@test",
            "@test:browser"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "process-timeout": 1800
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "lint": "Code style (Pint) and modernisation (Rector), without changing anything",
        "fix": "Apply Rector and Pint",
        "analyse": "PHPStan level 8, PHPMD, Deptrac layers, PHPArkitect rules",
        "test": "Unit, feature, architecture, security, regression and performance tests",
        "test:browser": "The user journey in a real browser (needs npm run build)",
        "test:mutation": "Mutation testing of our own code (needs a coverage driver)",
        "test:load": "Webhook storm against the running app, then checks the books",
        "check": "Everything the pipeline runs, except mutation testing"
    }
}
